# Database
DB_USER=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=protoqsar

# Database pool tuning
# DB_POOL_MAX=5
# DB_POOL_CONNECTION_TIMEOUT=5000
# DB_POOL_IDLE_TIMEOUT=30000
# DB_STATEMENT_TIMEOUT=30000
# DB_KEEPALIVES_IDLE=30000

# Auth and public application URLs
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://192.168.1.99:4000
VITE_API_BASE_URL=/api
SITE_URL=http://192.168.1.99:3000

# Redis used by BullMQ
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP for batch email and mailer endpoints
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
SMTP_PORT=587
SMTP_HOST=

# Optional seeded admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_USERNAME=admin
SEED_ADMIN_ROLE=admin
