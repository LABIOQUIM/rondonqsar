# Database
DB_USER=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=protoqsar

# Auth and public application URLs
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000

# Redis used by BullMQ
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP for batch email and mailer endpoints
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
SMTP_PORT=587
SMTP_HOST=

# Optional seeded admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_USERNAME=admin
SEED_ADMIN_ROLE=admin

# Optional runtime overrides
PORT=3000
SITE_URL=http://localhost:3000
SSR_PORT=3001
SSR_HOST=0.0.0.0

# Production Mold2 executable mounted into the API container
MOLD2_HOST_PATH=/usr/local/bin/Mold2
